# Local config, never committed.
# Copy config.example.js to config.js and drop in your real keys.
# config.js is loaded by every page before boot.js; without it the
# site runs on the keyless Tao Market Cap public API.
config.js

# Opt-in auth cookies for the SemiAnalysis crawler. Never committed.
# Format: {"substack.sid": "<value>", ...}. Drop one in if/when a
# paid subscription is in play; otherwise the crawler runs unauthed.
intelligence/_external_sources/semianalysis/.cookies.json
